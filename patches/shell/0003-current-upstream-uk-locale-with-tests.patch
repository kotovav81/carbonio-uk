+ */
+/*
+ * SPDX-FileCopyrightText: 2026 Котов Андрій
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+import { describe, expect, it } from 'vitest';
+
+import { DEFAULT_LOCALES, STATIC_LOCALES } from './default-locales';
+import { DATE_FNS_LOCALE } from './locales';
+
+describe('Ukrainian locale registration', () => {
+	it('registers uk with its native label and preserves existing locales', () => {
+		expect(STATIC_LOCALES.uk).toEqual({
+			name: 'Українська',
+			value: 'uk',
+			labelKey: 'locale.label_ukrainian',
+			labelDefaultValue: 'Ukrainian - {{value}}'
+		});
+		expect(DEFAULT_LOCALES.uk).toEqual(STATIC_LOCALES.uk);
+		expect(STATIC_LOCALES.pl.value).toBe('pl');
+		expect(STATIC_LOCALES.en.value).toBe('en');
+	});
+
+	it('loads Ukrainian date-fns data using the uk identifier', async () => {
+		const locale = await DATE_FNS_LOCALE.uk?.localeImportPath();
+		expect(locale?.code).toBe('uk');
+	});
+});
